{
  "name": "thp-music",
  "version": "1.0.0",
  "description": "An open source frontend for YouTube Music",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check public/script.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "node-fetch": "^3.3.2",
    "yt-dlp-wrap": "^2.3.12",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "redstar": {
      "minimatch": "^3.1.5"
    }
  }
}
